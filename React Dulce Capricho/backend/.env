# Puerto donde corre el servidor Express
PORT=4000

# Conexión a MySQL (XAMPP por defecto: usuario root y contraseña vacía)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dulce_capricho

# Clave para firmar el token JWT (cámbiala por una larga y aleatoria)
JWT_SECRET=clave_secreta_dulce_capricho
JWT_EXPIRES_IN=8h

# Datos de la administradora que crea el seed.js
SEED_ADMIN_NOMBRES=Administradora
SEED_ADMIN_APELLIDOS=Dulce Capricho
SEED_ADMIN_EMAIL=admin@dulcecapricho.com
SEED_ADMIN_PASSWORD=Admin123!